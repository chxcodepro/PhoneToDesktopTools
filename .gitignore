# 本地工具链（Go 等），不入库
.tools/

# 构建产物
dist/
build/
*.exe
*.apk

# Node / Expo
node_modules/
.expo/
web-build/
*.log

# 原生工程（由 expo prebuild 生成）
mobile/android/
mobile/ios/

# 编辑器
.vscode/
.idea/
.DS_Store

# 预存的 adb、APK 等二进制（体积大、有第三方许可），只保留说明
desktop/vendor/*
!desktop/vendor/README.md

# 签名证书（正式证书绝不能入库，见 docs/DEV.md「正式签名」）
*.jks
*.keystore
*.b64.txt
