{
  "name": "p2d-desktop",
  "productName": "P2D",
  "version": "0.1.2",
  "description": "P2D 电脑端（被控端）",
  "author": "P2D",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run icons && npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "dev": "npm run build && electron .",
    "stage-core": "node scripts/stage-core.mjs",
    "dist:win": "npm run build && npm run stage-core && node scripts/dist-win.mjs",
    "dist:win64": "npm run build && npm run stage-core && node scripts/dist-win.mjs --x64-only",
    "dist:linux": "npm run build && npm run stage-core && electron-builder --linux dir AppImage --x64 --arm64",
    "dist:mac": "npm run build && npm run stage-core && electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "22.3.27",
    "electron-builder": "26.18.0",
    "fflate": "0.8.3",
    "lucide-react": "0.577.0",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  },
  "build": {
    "appId": "com.p2d.desktop",
    "productName": "P2D",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "core-bin/${os}-${arch}",
        "to": "core"
      },
      {
        "from": "build/icons",
        "to": "icons"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "artifactName": "P2D-${version}-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "P2D",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": ["zh_CN"],
      "language": "2052",
      "include": "installer/installer.nsh"
    },
    "mac": {
      "icon": "build/icon-mac.png",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "artifactName": "P2D-${version}-mac-${arch}.${ext}",
      "minimumSystemVersion": "10.13",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "P2D 用来让访达把文件移到废纸篓（手机上的 Agent 删除文件时）"
      }
    },
    "dmg": {
      "title": "P2D ${version}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "P2D-${version}-linux-${arch}.${ext}"
    }
  }
}
